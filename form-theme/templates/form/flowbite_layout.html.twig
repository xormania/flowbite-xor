{#-
    flowbite-xor form theme. Rows render through the FormField component, controls through the Input,
    Select, Textarea, Checkbox, Radio, Label and Button components, so a Symfony form looks like the
    hand-written components. Blocks not overridden here come from Symfony's tailwind_2_layout.
-#}
{% use 'tailwind_2_layout.html.twig' %}

{#- Rows -#}

{##- A row: a FormField with the label, the control, its help and errors; a compound field (expanded choices, a date in three selects, a sub-form) is a fieldset with a legend. -#}
{%- block form_row -%}
    {%- set _row_kind = compound ? 'fieldset' : 'field' -%}
    {{- block('flowbite_row') -}}
{%- endblock form_row -%}

{##- A checkbox row: the checkbox, its label beside it, then help and errors. -#}
{%- block checkbox_row -%}
    {%- set _row_kind = 'check' -%}
    {{- block('flowbite_row') -}}
{%- endblock checkbox_row -%}

{##- A single radio row, laid out like a checkbox row. -#}
{%- block radio_row -%}
    {%- set _row_kind = 'check' -%}
    {{- block('flowbite_row') -}}
{%- endblock radio_row -%}

{##- Renders one row as a FormField, wiring aria-describedby and aria-invalid on the control. -#}
{%- block flowbite_row -%}
    {%- set _label = null -%}
    {%- if label is not same as(false) -%}
        {%- set _label -%}{##- The label text, translated, from Symfony's layout. -#}{{- block('form_label_content') -}}{%- endset -%}
    {%- endif -%}
    {%- set _help = null -%}
    {%- if help -%}
        {%- set _help -%}{##- The help text, translated, from Symfony's layout. -#}{{- block('form_help_content') -}}{%- endset -%}
    {%- endif -%}
    {%- set _errors = errors|map((error) => error.message) -%}
    {%- set _describedby = ((help ? [id ~ '_help'] : [])|merge(errors|length ? [id ~ '_error'] : []))|join(' ') -%}
    {%- set _control_aria = (_describedby ? {'aria-describedby': _describedby} : {})|merge(errors|length ? {'aria-invalid': 'true'} : {}) -%}
    {%- set _row_attr = row_attr|merge({class: row_attr.class|default(row_class|default('mb-6'))}) -%}
    {%- if 'fieldset' == _row_kind -%}
        {%- set _row_attr = _describedby ? _row_attr|merge({'aria-describedby': _describedby}) : _row_attr -%}
        <twig:FormField as="fieldset" for="{{ id }}" :label="_label" :help="_help" :error="_errors" :required="required" {{ ..._row_attr }}>
            {{- form_widget(form) -}}
        </twig:FormField>
    {%- elseif 'check' == _row_kind -%}
        <twig:FormField for="{{ id }}" :help="_help" :error="_errors" {{ ..._row_attr }}>
            <div class="flex items-center gap-2">
                {{- form_widget(form, {attr: _control_aria}) -}}
                {{- form_label(form, null, {label_attr: {class: 'select-none'}}) -}}
            </div>
        </twig:FormField>
    {%- else -%}
        <twig:FormField for="{{ id }}" :label="_label" :help="_help" :error="_errors" :required="required" {{ ..._row_attr }}>
            {{- form_widget(form, {attr: _control_aria}) -}}
        </twig:FormField>
    {%- endif -%}
{%- endblock flowbite_row -%}

{#- Labels, help, errors outside a row (form_label(), form_help(), form_errors()) -#}

{##- A label outside a row, through the Label component (its invalid variant when the field has errors). -#}
{%- block form_label -%}
    {%- if label is not same as(false) -%}
        {%- set _label -%}{{- block('form_label_content') -}}{%- endset -%}
        {%- set _label_attr = compound ? label_attr : label_attr|merge({for: id}) -%}
        <twig:Label :variant="errors|length ? 'invalid' : 'default'" {{ ..._label_attr }}>{{ _label }}</twig:Label>
    {%- endif -%}
{%- endblock form_label -%}

{##- Help text outside a row, with the id and classes of FormField's help. -#}
{%- block form_help -%}
    {%- if help -%}
        <p id="{{ id }}_help" class="{{ help_attr.class|default('mt-2.5 text-sm text-body') }}">{{- block('form_help_content') -}}</p>
    {%- endif -%}
{%- endblock form_help -%}

{##- Errors outside a row (and the form's own errors), with the id and classes of FormField's error. -#}
{%- block form_errors -%}
    {%- if errors|length > 0 -%}
        {%- if errors|length == 1 -%}
            <p id="{{ id }}_error" class="mt-2.5 text-sm text-fg-danger-strong">{{ (errors|first).message }}</p>
        {%- else -%}
            <ul id="{{ id }}_error" class="mt-2.5 list-inside list-disc space-y-1 text-sm text-fg-danger-strong">
                {%- for error in errors %}<li>{{ error.message }}</li>{% endfor -%}
            </ul>
        {%- endif -%}
    {%- endif -%}
{%- endblock form_errors -%}

{#- Controls -#}

{##- Text-like inputs through the Input component; hidden, range and color inputs keep Symfony's markup. -#}
{%- block form_widget_simple -%}
    {%- set type = type|default('text') -%}
    {%- if type in ['hidden', 'range', 'color'] -%}
        {{- parent() -}}
    {%- else -%}
        {%- set _control = 'Input' -%}
        {%- set _control_attr = {type: type, value: value is empty ? null : value} -%}
        {{- block('flowbite_control') -}}
    {%- endif -%}
{%- endblock form_widget_simple -%}

{##- A textarea through the Textarea component. -#}
{%- block textarea_widget -%}
    {%- set _control = 'Textarea' -%}
    {%- set _control_content = value -%}
    {{- block('flowbite_control') -}}
{%- endblock textarea_widget -%}

{##- A collapsed choice through the Select component. -#}
{%- block choice_widget_collapsed -%}
    {%- if required and placeholder is none and not placeholder_in_choices and not multiple and (attr.size is not defined or attr.size <= 1) -%}
        {%- set required = false -%}
    {%- endif -%}
    {%- set _control_content -%}
        {%- if placeholder is not none -%}
            <option value=""{% if placeholder_attr|default({}) %}{% with {attr: placeholder_attr} %}{##- The placeholder option's attributes, from Symfony's layout. -#}{{ block('attributes') }}{% endwith %}{% endif %}{% if required and value is empty %} selected="selected"{% endif %}>{{ placeholder != '' ? (translation_domain is same as(false) ? placeholder : placeholder|trans({}, translation_domain)) }}</option>
        {%- endif -%}
        {%- if preferred_choices|length > 0 -%}
            {%- set options = preferred_choices -%}
            {%- set render_preferred_choices = true -%}
            {##- The options, from Symfony's layout. -#}
            {{- block('choice_widget_options') -}}
            {%- if choices|length > 0 and separator is not none -%}
                {%- if separator_html is not defined or separator_html is same as(false) -%}
                    <option disabled="disabled">{{ separator }}</option>
                {%- else -%}
                    {{ separator|raw }}
                {%- endif -%}
            {%- endif -%}
        {%- endif -%}
        {%- set options = choices -%}
        {%- set render_preferred_choices = false -%}
        {{- block('choice_widget_options') -}}
    {%- endset -%}
    {%- set _control = 'Select' -%}
    {%- set _control_attr = {multiple: multiple} -%}
    {{- block('flowbite_control') -}}
{%- endblock choice_widget_collapsed -%}

{##- Expanded choices: each radio or checkbox with its label beside it. -#}
{%- block choice_widget_expanded -%}
    {%- set attr = attr|merge({class: attr.class|default('space-y-3')}) -%}
    <div {## The container's id and attributes, from Symfony's layout. #}{{ block('widget_container_attributes') }}>
        {%- for child in form %}
            <div class="flex items-center gap-2">
                {{- form_widget(child) -}}
                {{- form_label(child, null, {translation_domain: choice_translation_domain, label_attr: {class: 'select-none'}}) -}}
            </div>
        {%- endfor -%}
    </div>
{%- endblock choice_widget_expanded -%}

{##- A checkbox through the Checkbox component. -#}
{%- block checkbox_widget -%}
    {%- set _control = 'Checkbox' -%}
    {%- set _control_attr = {value: value is defined ? value : null, checked: checked} -%}
    {{- block('flowbite_control') -}}
{%- endblock checkbox_widget -%}

{##- A radio through the Radio component. -#}
{%- block radio_widget -%}
    {%- set _control = 'Radio' -%}
    {%- set _control_attr = {value: value is defined ? value : null, checked: checked} -%}
    {{- block('flowbite_control') -}}
{%- endblock radio_widget -%}

{##- A button through the Button component; `attr: {variant: ...}` picks its variant. -#}
{%- block button_widget -%}
    {%- set _control_content -%}{{- block('form_label_content') -}}{%- endset -%}
    {%- set _control = 'Button' -%}
    {%- set _control_attr = {type: type|default('button'), required: null} -%}
    {{- block('flowbite_control') -}}
{%- endblock button_widget -%}

{##- Renders the component named by `_control` with the attributes Symfony's widget_attributes would print, merged with `_control_attr`, and `_control_content` as its content. -#}
{%- block flowbite_control -%}
    {%- set _attrs = {id: id, name: full_name, disabled: disabled, required: required|default(false)} -%}
    {%- for _name, _value in attr -%}
        {%- if _name in ['placeholder', 'title'] and translation_domain is not same as(false) and _value is not null -%}
            {%- set _value = _value|trans(attr_translation_parameters, translation_domain) -%}
        {%- endif -%}
        {%- set _attrs = _attrs|merge({(_name): _value}) -%}
    {%- endfor -%}
    {%- set _attrs = _attrs|merge(_control_attr|default({}))|filter((value) => value is not null) -%}
    {%- if 'Select' == _control -%}
        <twig:Select {{ ..._attrs }}>{{ _control_content }}</twig:Select>
    {%- elseif 'Textarea' == _control -%}
        <twig:Textarea {{ ..._attrs }}>{{ _control_content }}</twig:Textarea>
    {%- elseif 'Button' == _control -%}
        <twig:Button {{ ..._attrs }}>{{ _control_content }}</twig:Button>
    {%- else -%}
        {{ component(_control, _attrs) }}
    {%- endif -%}
{%- endblock flowbite_control -%}
