{%- props
    ## string The page title, rendered as the page's `h1`.
    title,
    ## string|null A line describing the page.
    description = null
-%}
<header {{ attributes.defaults({class: 'flex flex-col gap-4 border-b border-default pb-5 sm:flex-row sm:items-end sm:justify-between'|tailwind_classes}) }}>
    <div class="min-w-0">
        {##- Content above the title, typically a `Breadcrumb`. -#}
        {%- block before %}{% endblock -%}
        <h1 class="text-2xl font-semibold tracking-tight text-heading">{{ title }}</h1>
        {%- if description %}
            <p class="mt-1 text-sm text-body">{{ description }}</p>
        {%- endif %}
    </div>
    <div class="flex shrink-0 flex-wrap items-center gap-3">
        {##- The page's actions, typically buttons. -#}
        {%- block actions %}{% endblock -%}
    </div>
</header>
