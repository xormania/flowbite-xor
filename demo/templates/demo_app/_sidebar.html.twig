{#- The application's pages, then the kit's own pages, in one SideNav: the /lab and /forms pages need the server and are left out of the static copy. -#}
{%- set static_export = app.request.attributes.get('_static_export') -%}
<twig:SideNav label="Acme" storageKey="demo-nav">
    <twig:SideNav:Item href="{{ path('app_demo') }}" route="app_demo">
        <twig:block name="icon"><twig:ux:icon name="flowbite:chart-pie-outline" class="size-5" /></twig:block>
        Dashboard
    </twig:SideNav:Item>
    <twig:SideNav:Branch label="Settings">
        <twig:block name="icon"><twig:ux:icon name="flowbite:user-outline" class="size-5" /></twig:block>
        <twig:SideNav:Item href="{{ path('app_demo_settings_profile') }}" route="app_demo_settings_profile">Profile</twig:SideNav:Item>
    </twig:SideNav:Branch>
    <twig:SideNav:Branch label="Pages">
        <twig:block name="icon"><twig:ux:icon name="flowbite:grid-outline" class="size-5" /></twig:block>
        <twig:SideNav:Branch label="Account">
            <twig:SideNav:Item href="{{ path('app_demo_login') }}">Sign in</twig:SideNav:Item>
            <twig:SideNav:Item href="{{ path('app_demo_signup') }}">Sign up</twig:SideNav:Item>
            <twig:SideNav:Item href="{{ path('app_demo_forgot_password') }}">Forgot password</twig:SideNav:Item>
        </twig:SideNav:Branch>
        <twig:SideNav:Branch label="Errors">
            <twig:SideNav:Item href="{{ path('app_demo_not_found') }}">Not found</twig:SideNav:Item>
        </twig:SideNav:Branch>
        <twig:SideNav:Item href="{{ path('app_demo_blank') }}">Blank page</twig:SideNav:Item>
    </twig:SideNav:Branch>
    <twig:SideNav:Branch label="Showcase">
        <twig:block name="icon"><twig:ux:icon name="flowbite:code-outline" class="size-5" /></twig:block>
        <twig:SideNav:Item href="{{ path('app_index') }}">Recipes</twig:SideNav:Item>
        {%- if not static_export %}
            <twig:SideNav:Item href="{{ path('app_forms') }}">Forms</twig:SideNav:Item>
            <twig:SideNav:Item href="{{ path('app_lab') }}">Lab</twig:SideNav:Item>
        {%- endif %}
    </twig:SideNav:Branch>
</twig:SideNav>
