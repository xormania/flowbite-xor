{% extends 'base.html.twig' %}

{% block title %}calendar-stream — Lab{% endblock %}

{% block body %}
    {{ include('lab/_header.html.twig', {name: 'calendar-stream'}) }}
    <form method="post" action="{{ path('app_lab_calendar_stream') }}" class="mb-4 flex gap-3">
        <twig:Button type="submit" name="action" value="replace" variant="secondary">Replace the calendar</twig:Button>
        <twig:Button type="submit" name="action" value="update" variant="secondary">Update the calendar</twig:Button>
    </form>
    <div id="calendar-region">{{ include('lab/_calendar_streamed.html.twig') }}</div>
{% endblock %}
