{% extends 'base.html.twig' %}

{% block title %}popover-stream — Lab{% endblock %}

{% block body %}
    {{ include('lab/_header.html.twig', {name: 'popover-stream'}) }}
    <form method="post" action="{{ path('app_lab_popover_stream') }}" class="mb-4 flex gap-3">
        <twig:Button type="submit" name="action" value="replace" variant="secondary">Replace the popover</twig:Button>
        <twig:Button type="submit" name="action" value="update" variant="secondary">Update the popover</twig:Button>
    </form>
    <div id="popover-region">{{ include('lab/_popover_streamed.html.twig') }}</div>
{% endblock %}
