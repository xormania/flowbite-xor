{% extends 'base.html.twig' %}

{% block title %}markdown-turbo ({{ page }}) — Lab{% endblock %}

{% block body %}
    {{ include('lab/_header.html.twig', {name: 'markdown-turbo'}) }}
    <h2 class="mb-2 text-lg font-semibold" data-testid="page">Page {{ page }}</h2>
    <p class="mb-6"><a href="{{ path('app_lab_markdown_turbo', {page: page == 'one' ? 'two' : 'one'}) }}" class="text-fg-brand hover:underline">Go to page {{ page == 'one' ? 'two' : 'one' }}</a></p>
    {% if saved is not null %}
        <div class="mb-6 max-w-xl rounded-base border border-default p-4">
            <p class="mb-2 text-sm font-medium text-heading">Published</p>
            <div data-testid="saved-rendered">{{ saved|flowbite_markdown_html }}</div>
            <pre class="mt-2 text-xs whitespace-pre-wrap text-body" data-testid="saved-markdown">{{ saved }}</pre>
        </div>
    {% endif %}
    <div class="grid max-w-5xl gap-8 lg:grid-cols-2">
        <div>
            {{ form_start(form, {attr: {novalidate: true}}) }}
                {{ form_widget(form) }}
            {{ form_end(form) }}
        </div>
        <div class="space-y-8">
            <div id="lab-permanent-markdown" data-turbo-permanent>
                <twig:FormField for="kept" label="Kept notes">
                    <twig:MarkdownEditor id="kept" name="kept" rows="3" value="Kept across visits." />
                </twig:FormField>
            </div>
            <turbo-frame id="markdown-frame" class="block">
                <p class="mb-2">Frame load <span data-testid="frame-load">{{ load }}</span> · <a href="{{ path('app_lab_markdown_turbo', {page: page, load: load + 1}) }}" class="text-fg-brand hover:underline">Reload the frame</a></p>
                <twig:FormField for="framed" label="Framed notes">
                    <twig:MarkdownEditor id="framed" name="framed" rows="3" value="In a **frame**." />
                </twig:FormField>
            </turbo-frame>
        </div>
    </div>
{% endblock %}
