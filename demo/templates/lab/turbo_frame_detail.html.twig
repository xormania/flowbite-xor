{% extends 'base.html.twig' %}

{% block title %}turbo-frame-detail — Lab{% endblock %}

{% block body %}
    {{ include('lab/_header.html.twig', {name: 'turbo-frame-detail'}) }}
    <div class="grid grid-cols-[12rem_1fr] gap-6">
        <nav aria-label="Items">
            <ul>
                {% for id, label in items %}
                    <li><a href="{{ path('app_lab_turbo_frame_detail', {item: id}) }}" data-turbo-frame="detail" class="text-fg-brand hover:underline">{{ label }}</a></li>
                {% endfor %}
            </ul>
        </nav>
        <turbo-frame id="detail">
            {% if item %}
                <h2 class="text-lg font-semibold" data-testid="detail-title">{{ items[item] }}</h2>
                <twig:Dropdown id="detail-{{ item }}">
                    <twig:Dropdown:Trigger>
                        <twig:Button {{ ...dropdown_trigger_attrs }}>Options for {{ items[item] }}</twig:Button>
                    </twig:Dropdown:Trigger>
                    <twig:Dropdown:Content>
                        <twig:Dropdown:Group>
                            <twig:Dropdown:Item href="#">Edit {{ items[item] }}</twig:Dropdown:Item>
                            <twig:Dropdown:Item href="#">Archive {{ items[item] }}</twig:Dropdown:Item>
                        </twig:Dropdown:Group>
                    </twig:Dropdown:Content>
                </twig:Dropdown>
            {% else %}
                <p class="text-body">Select an item.</p>
            {% endif %}
        </turbo-frame>
    </div>
{% endblock %}
