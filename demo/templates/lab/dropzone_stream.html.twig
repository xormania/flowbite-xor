{% extends 'base.html.twig' %}

{% block title %}dropzone-stream — Lab{% endblock %}

{% block body %}
    {{ include('lab/_header.html.twig', {name: 'dropzone-stream'}) }}
    <form method="post" action="{{ path('app_lab_dropzone_stream') }}" class="mb-4 flex gap-3">
        <twig:Button type="submit" name="action" value="replace" variant="secondary">Replace the dropzone</twig:Button>
        <twig:Button type="submit" name="action" value="update" variant="secondary">Update the dropzone</twig:Button>
    </form>
    <div id="dropzone-region" class="max-w-sm">{{ include('lab/_dropzone_streamed.html.twig') }}</div>
{% endblock %}
