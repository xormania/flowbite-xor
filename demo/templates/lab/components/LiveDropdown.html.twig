<div {{ attributes }}>
    <p>Actions: <span data-testid="renders">{{ renders }}</span>, query: <span data-testid="query">{{ query }}</span></p>
    <twig:Dropdown id="live">
        <twig:Dropdown:Trigger>
            <twig:Button {{ ...dropdown_trigger_attrs }}>Menu</twig:Button>
        </twig:Dropdown:Trigger>
        <twig:Dropdown:Content>
            <twig:Dropdown:Group>
                <twig:Dropdown:Item href="#">Dashboard</twig:Dropdown:Item>
                <twig:Dropdown:Item href="#">Settings</twig:Dropdown:Item>
            </twig:Dropdown:Group>
            <div class="p-3 space-y-2">
                <twig:Button size="sm" data-action="live#action" data-live-action-param="rerender">Re-render</twig:Button>
                <label class="block text-sm text-body">Query
                    <input type="text" data-model="query" class="mt-1 block w-full rounded-base border border-default-medium bg-neutral-secondary-medium px-2 py-1 text-heading">
                </label>
            </div>
        </twig:Dropdown:Content>
    </twig:Dropdown>
</div>
