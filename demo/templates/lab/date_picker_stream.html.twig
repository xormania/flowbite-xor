{% extends 'base.html.twig' %}

{% block title %}date-picker-stream — Lab{% endblock %}

{% block body %}
    {{ include('lab/_header.html.twig', {name: 'date-picker-stream'}) }}
    <form method="post" action="{{ path('app_lab_date_picker_stream') }}" class="mb-4 flex gap-3">
        <twig:Button type="submit" name="action" value="replace" variant="secondary">Replace the picker</twig:Button>
        <twig:Button type="submit" name="action" value="update" variant="secondary">Update the picker</twig:Button>
    </form>
    <div id="date-picker-region">{{ include('lab/_date_picker_streamed.html.twig') }}</div>
{% endblock %}
