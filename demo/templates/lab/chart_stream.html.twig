{% extends 'base.html.twig' %}

{% block title %}chart-stream — Lab{% endblock %}

{% block body %}
    {{ include('lab/_header.html.twig', {name: 'chart-stream'}) }}
    <form method="post" action="{{ path('app_lab_chart_stream') }}" class="mb-4 flex gap-3">
        <twig:Button type="submit" name="action" value="replace" variant="secondary">Replace the chart</twig:Button>
        <twig:Button type="submit" name="action" value="update" variant="secondary">Update the chart</twig:Button>
    </form>
    <div id="chart-region" class="max-w-xl">{{ include('lab/_chart_streamed.html.twig') }}</div>
{% endblock %}
