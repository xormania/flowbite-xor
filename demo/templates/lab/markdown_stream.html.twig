{% extends 'base.html.twig' %}

{% block title %}markdown-stream — Lab{% endblock %}

{% block body %}
    {{ include('lab/_header.html.twig', {name: 'markdown-stream'}) }}
    <form method="post" action="{{ path('app_lab_markdown_stream') }}" class="mb-4 flex gap-3">
        <twig:Button type="submit" name="action" value="replace" variant="secondary">Replace the editor</twig:Button>
        <twig:Button type="submit" name="action" value="update" variant="secondary">Update the editor</twig:Button>
    </form>
    <div id="markdown-region" class="max-w-xl">{{ include('lab/_markdown_streamed.html.twig') }}</div>
{% endblock %}
