{%- props
    ## Symfony\Component\Form\FormView The form asking for the email address.
    form,
    ## boolean Whether the reset link was sent: shows the confirmation instead of the form.
    sent = false,
    ## string The card title, the page's `h1`.
    title = 'Forgot your password?',
    ## string The line under the title.
    description = 'Enter the email address of your account and we will send you a link to reset your password.',
    ## string The confirmation shown once the link is sent.
    sentMessage = 'If an account exists for that email address, a link to reset the password is on its way.',
    ## string The label of the submit button.
    submitLabel = 'Send the reset link',
    ## string|null The link back to the login page.
    loginHref = null
-%}
{#- the block renders its form through the form-theme recipe, whatever twig.form_themes says -#}
{%- form_theme form 'form/flowbite_layout.html.twig' -%}
<div {{ attributes.defaults({class: 'w-full'|tailwind_classes}) }}>
    <twig:Card>
        <twig:Card:Header>
            <twig:Card:Title as="h1" class="text-xl">{{ title }}</twig:Card:Title>
            {%- if not sent %}<p class="mt-2 text-sm text-body">{{ description }}</p>{% endif %}
        </twig:Card:Header>
        <twig:Card:Content>
            {%- if sent %}
                <twig:Alert variant="success"><twig:Alert:Description>{{ sentMessage }}</twig:Alert:Description></twig:Alert>
            {%- else %}
                {{ form_start(form) }}
                    {{ form_widget(form) }}
                    <twig:Button type="submit" class="w-full">{{ submitLabel }}</twig:Button>
                {{ form_end(form) }}
            {%- endif %}
        </twig:Card:Content>
        {%- if loginHref %}
            <p class="mt-6 text-center text-sm text-body"><a href="{{ loginHref }}" class="font-medium text-fg-brand underline hover:no-underline">Back to sign in</a></p>
        {%- endif %}
    </twig:Card>
</div>
